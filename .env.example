# Example configuration for private deployments; never put secrets in site/ or public JavaScript.
PORT=8000
CHRONOS_HOST=0.0.0.0
CHRONOS_DATA_DIR=/var/data
# Explicit allowed browser origins, comma-separated. Keep only origins you control.
CHRONOS_ALLOWED_ORIGINS=https://infotelcom.github.io

# Bootstrap the first administrator once. Use a unique password of 14+ characters.
# Set these only in the private backend host's secret/environment settings; never commit real values.
CHRONOS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CHRONOS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_14_PLUS_CHARACTER_PASSWORD
